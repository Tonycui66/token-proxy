# ===== 复制本文件为 .env 后填入真实值；.env 不得提交 Git =====

# 管理员（主）Key —— 用于管理界面和创建虚拟 Key，绝不用于日常客户端
LITELLM_MASTER_KEY=sk-master-change-me

# 上游供应商 Key（二选一或都填；留空的模型路由不可用）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 服务监听（原生 pip 运行时由启动脚本读取）
LITELLM_HOST=127.0.0.1
LITELLM_PORT=5555

# Phase 3 启用 PostgreSQL 时取消注释
# DATABASE_URL=postgresql://litellm:CHANGE_ME@localhost:5432/litellm
